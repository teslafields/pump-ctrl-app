/*
 * Devicetree overlay for SHT3xD and INA219 sensors on I2C0,
 * BOOT button on GPIO 9, and Pump MOSFET gate on GPIO 3.
 *
 * SPDX-License-Identifier: Apache-2.0
 */

/ {
	aliases {
		sw0 = &boot_button;
		pump-gate = &pump_gate;
	};

	gpio_keys {
		compatible = "gpio-keys";
		boot_button: button_0 {
			label = "BOOT Button";
			gpios = <&gpio0 9 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		};
	};

	pump_control {
		compatible = "gpio-leds";
		pump_gate: pump_gate_0 {
			label = "Pump MOSFET Gate";
			gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
		};
	};
};

&i2c0 {
	clock-frequency = <I2C_BITRATE_STANDARD>;

	sht3xd: sht3xd@44 {
		compatible = "sensirion,sht3xd";
		reg = <0x44>;
		status = "okay";
	};

	ina219: ina219@40 {
		compatible = "ti,ina219";
		reg = <0x40>;
		status = "okay";
		brng = <0>;
		pg = <3>;
		sadc = <3>;
		badc = <3>;
		shunt-milliohm = <100>;
		lsb-microamp = <100>;
	};
};
